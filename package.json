{
  "name": "avtoqism-uz",
  "version": "1.0.0",
  "description": "Avtomobil ehtiyot qismlarini katalog bo‘yicha qidirish va sotib olish internet do‘koni (BMI)",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "seed": "node prisma/seed.mjs",
    "db:neon": "node scripts/set-db.mjs neon",
    "db:sqlite": "node scripts/set-db.mjs sqlite",
    "render:build": "prisma db push && node prisma/seed.mjs && next build",
    "render:start": "next start"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.55.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
